# Copy this file to .env and fill in your own values.
# Never commit .env - it is already gitignored.
#
# See README.md "Authentication" section for how to generate a PAT/SAT
# in Cisco IQ (User Settings > Personal Token Management, or
# System Settings > Identity and Access for service accounts).

# Exactly one of these is required.
# Personal Access Token (human user, exploratory/scripted use):
CISCO_IQ_PAT=

# Service Account Token (machine-to-machine, Administrator accounts only):
# CISCO_IQ_SAT=

# Required. Find at Cisco IQ: Home > System Settings > Account Details.
# Required for PAT auth; optional for SAT (must match the service account's
# own account if provided).
CISCO_IQ_ACCOUNT_ID=

# Required. One of: US, EMEA, APJC.
CISCO_IQ_REGION=

# Optional. Overrides the default production base URL.
# CISCO_IQ_BASE_URL=https://iq.cisco.com
